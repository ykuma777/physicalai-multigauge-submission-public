<?xml version="1.0"?>
<sdf version="1.8">
  <world name="camera_demo">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.75 0.8 0.85 1</background>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <model name="camera_demo_ground">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></collision>
        <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material><ambient>0.55 0.58 0.6 1</ambient><diffuse>0.55 0.58 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="camera_demo_table">
      <static>true</static>
      <pose>0.29 0 0 0 0 0</pose>
      <link name="top">
        <pose>0 0 1.0 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.51 0.5 0.03</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.51 0.5 0.03</size></box></geometry>
          <material><ambient>0.55 0.38 0.23 1</ambient><diffuse>0.55 0.38 0.23 1</diffuse></material>
        </visual>
      </link>
      <link name="legs">
        <visual name="front_left"><pose>-0.21 -0.2 0.493 0 0 0</pose><geometry><box><size>0.025 0.025 0.985</size></box></geometry></visual>
        <visual name="front_right"><pose>-0.21 0.2 0.493 0 0 0</pose><geometry><box><size>0.025 0.025 0.985</size></box></geometry></visual>
        <visual name="back_left"><pose>0.21 -0.2 0.493 0 0 0</pose><geometry><box><size>0.025 0.025 0.985</size></box></geometry></visual>
        <visual name="back_right"><pose>0.21 0.2 0.493 0 0 0</pose><geometry><box><size>0.025 0.025 0.985</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
